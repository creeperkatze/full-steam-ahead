{
	"name": "full-steam-ahead",
	"version": "1.6.2",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tauri dev --features disable-auto-updates",
		"build": "tauri build",
		"web:dev": "vite",
		"web:build": "vue-tsc --noEmit && vite build",
		"lint": "oxlint && cargo clippy --manifest-path src-tauri/Cargo.toml",
		"lint:fix": "oxlint --fix && cargo clippy --manifest-path src-tauri/Cargo.toml --fix --allow-dirty",
		"fmt": "oxfmt && cargo fmt --manifest-path src-tauri/Cargo.toml",
		"fmt:check": "oxfmt --check && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
		"typecheck": "vue-tsc --noEmit",
		"gen:bindings": "cargo run --manifest-path src-tauri/Cargo.toml -- --export-bindings",
		"test": "cargo test --manifest-path src-tauri/Cargo.toml",
		"test:coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --lcov --output-path lcov.info",
		"intl:prune": "node scripts/prune-locales.js",
		"version": "node scripts/sync-version.js",
		"release:patch": "pnpm version patch && git push && git push --tags",
		"release:minor": "pnpm version minor && git push && git push --tags",
		"release:major": "pnpm version major && git push && git push --tags"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/vue": "^1.56.0",
		"@tauri-apps/api": "^2.12.3",
		"@tauri-apps/plugin-dialog": "^2.8.2",
		"@tauri-apps/plugin-opener": "^2.7.1",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-updater": "^2.13.3",
		"markdown-it": "^15.0.2",
		"vue": "^3.5.44",
		"vue-i18n": "^11.4.14",
		"vue-router": "^5.4.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.12.2",
		"@types/node": "^26.6.5",
		"@vitejs/plugin-vue": "^6.0.10",
		"autoprefixer": "^10.6.1",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"postcss": "^8.5.30",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vite-svg-loader": "^5.1.3",
		"vue-tsc": "^3.3.13"
	},
	"packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
