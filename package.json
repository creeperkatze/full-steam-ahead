{
    "name": "full-steam-ahead",
    "version": "1.3.10",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
    "scripts": {
        "dev": "tauri dev --features disable-auto-updates",
        "dev:web": "vite",
        "build": "tauri build",
        "build:web": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "lint": "eslint src/ && cargo clippy --manifest-path src-tauri/Cargo.toml && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
        "lint:fix": "eslint src/ --fix && cargo clippy --manifest-path src-tauri/Cargo.toml --fix --allow-dirty && cargo fmt --manifest-path src-tauri/Cargo.toml",
        "typecheck": "vue-tsc --noEmit",
        "test": "cargo test --manifest-path src-tauri/Cargo.toml",
        "test:coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --lcov --output-path lcov.info",
        "version": "node scripts/sync-version.js",
        "release:patch": "pnpm version patch && git push && git push --tags",
        "release:minor": "pnpm version minor && git push && git push --tags",
        "release:major": "pnpm version major && git push && git push --tags"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@lucide/vue": "^1.45.0",
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-dialog": "^2.7.3",
        "@tauri-apps/plugin-opener": "^2.5.5",
        "@tauri-apps/plugin-process": "^2.3.1",
        "@tauri-apps/plugin-updater": "^2.11.0",
        "marked": "^18.0.13",
        "vue": "^3.5.42",
        "vue-i18n": "^11.4.10",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2.11.4",
        "@types/node": "^26.5.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "autoprefixer": "^10.6.0",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-vue": "^10.11.0",
        "postcss": "^8.5.28",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vite-svg-loader": "^5.1.3",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.11"
    }
}
