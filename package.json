{
    "name": "full-steam-ahead",
    "version": "1.0.26",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.1.2",
    "scripts": {
        "dev": "tauri dev",
        "dev:web": "vite",
        "build": "tauri build",
        "build:web": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "lint": "eslint src/ && cargo clippy --manifest-path src-tauri/Cargo.toml && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
        "lint:fix": "eslint src/ --fix && cargo clippy --manifest-path src-tauri/Cargo.toml --fix --allow-dirty && cargo fmt --manifest-path src-tauri/Cargo.toml",
        "typecheck": "vue-tsc --noEmit",
        "test": "cargo test --manifest-path src-tauri/Cargo.toml",
        "release:patch": "pnpm version patch && git push && git push --tags",
        "release:minor": "pnpm version minor && git push && git push --tags",
        "release:major": "pnpm version major && git push && git push --tags"
    },
    "dependencies": {
        "@lucide/vue": "^1.34.0",
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-dialog": "^2.7.2",
        "@tauri-apps/plugin-opener": "^2.5.4",
        "vue": "^3.5.41",
        "vue-router": "^5.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2.11.4",
        "@types/node": "^25.9.5",
        "@vitejs/plugin-vue": "^6.0.8",
        "autoprefixer": "^10.5.4",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "eslint-plugin-vue": "^10.10.0",
        "postcss": "^8.5.26",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.2.2",
        "vite-svg-loader": "^5.1.1",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.11"
    }
}